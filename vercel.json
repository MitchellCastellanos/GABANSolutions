{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "digital.gabansolutions.ca"
        }
      ],
      "destination": "/digital.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "software.gabansolutions.ca"
        }
      ],
      "destination": "/software.html"
    },
    {
      "source": "/preview/:segments*",
      "destination": "/api/preview/:segments*"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/bookings",
      "destination": "/admin/bookings.html"
    },
    {
      "source": "/admin/previews",
      "destination": "/admin/previews.html"
    }
  ],
  "redirects": [
    {
      "source": "/leadgen-admin.html",
      "destination": "/admin/previews",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/preview/:segments*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/send-proposal", "schedule": "0 13 * * *" }
  ]
}
