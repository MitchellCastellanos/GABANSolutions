{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/preview/:segments*",
      "destination": "/api/preview/:segments*"
    },
    {
      "source": "/blog",
      "destination": "/api/blog"
    },
    {
      "source": "/blog/:segments*",
      "destination": "/api/blog/:segments*"
    },
    {
      "source": "/blog-sitemap.xml",
      "destination": "/api/blog-sitemap.xml"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/bookings",
      "destination": "/admin/bookings.html"
    },
    {
      "source": "/admin/previews",
      "destination": "/admin/previews.html"
    },
    {
      "source": "/admin/blog",
      "destination": "/admin/blog.html"
    },
    {
      "source": "/admin/analytics",
      "destination": "/admin/analytics.html"
    }
  ],
  "redirects": [
    {
      "source": "/leadgen-admin.html",
      "destination": "/admin/previews",
      "permanent": false
    },

    { "source": "/", "has": [{ "type": "header", "key": "host", "value": "digital.gabansolutions.ca" }], "destination": "https://gabansolutions.ca/digital/", "permanent": true },
    { "source": "/index.html", "has": [{ "type": "header", "key": "host", "value": "digital.gabansolutions.ca" }], "destination": "https://gabansolutions.ca/digital/", "permanent": true },
    { "source": "/:page(websites|seo|landing-pages|automations|ecommerce|pricing)", "has": [{ "type": "header", "key": "host", "value": "digital.gabansolutions.ca" }], "destination": "https://gabansolutions.ca/digital/:page", "permanent": true },
    { "source": "/:page(websites|seo|landing-pages|automations|ecommerce|pricing).html", "has": [{ "type": "header", "key": "host", "value": "digital.gabansolutions.ca" }], "destination": "https://gabansolutions.ca/digital/:page", "permanent": true },
    { "source": "/:page(contact|book|grow-package|express|mockup|portfolio|work|about|services|thank-you|blog)", "has": [{ "type": "header", "key": "host", "value": "digital.gabansolutions.ca" }], "destination": "https://gabansolutions.ca/:page", "permanent": true },
    { "source": "/:page(contact|book|grow-package|express|mockup|portfolio|work|about|services|thank-you|blog).html", "has": [{ "type": "header", "key": "host", "value": "digital.gabansolutions.ca" }], "destination": "https://gabansolutions.ca/:page", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "header", "key": "host", "value": "digital.gabansolutions.ca" }], "destination": "https://gabansolutions.ca/", "permanent": true },

    { "source": "/", "has": [{ "type": "header", "key": "host", "value": "software.gabansolutions.ca" }], "destination": "https://gabansolutions.ca/software/", "permanent": true },
    { "source": "/index.html", "has": [{ "type": "header", "key": "host", "value": "software.gabansolutions.ca" }], "destination": "https://gabansolutions.ca/software/", "permanent": true },
    { "source": "/:page(garageos|fieldos|booking-system|pricing)", "has": [{ "type": "header", "key": "host", "value": "software.gabansolutions.ca" }], "destination": "https://gabansolutions.ca/software/:page", "permanent": true },
    { "source": "/:page(garageos|fieldos|booking-system|pricing).html", "has": [{ "type": "header", "key": "host", "value": "software.gabansolutions.ca" }], "destination": "https://gabansolutions.ca/software/:page", "permanent": true },
    { "source": "/:page(contact|book|grow-package|express|mockup|portfolio|work|about|services|thank-you|blog)", "has": [{ "type": "header", "key": "host", "value": "software.gabansolutions.ca" }], "destination": "https://gabansolutions.ca/:page", "permanent": true },
    { "source": "/:page(contact|book|grow-package|express|mockup|portfolio|work|about|services|thank-you|blog).html", "has": [{ "type": "header", "key": "host", "value": "software.gabansolutions.ca" }], "destination": "https://gabansolutions.ca/:page", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "header", "key": "host", "value": "software.gabansolutions.ca" }], "destination": "https://gabansolutions.ca/", "permanent": true },

    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/book.html", "destination": "/book", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/digital/index.html", "destination": "/digital/", "permanent": true },
    { "source": "/digital/automations.html", "destination": "/digital/automations", "permanent": true },
    { "source": "/digital/ecommerce.html", "destination": "/digital/ecommerce", "permanent": true },
    { "source": "/digital/landing-pages.html", "destination": "/digital/landing-pages", "permanent": true },
    { "source": "/digital/pricing.html", "destination": "/digital/pricing", "permanent": true },
    { "source": "/digital/seo.html", "destination": "/digital/seo", "permanent": true },
    { "source": "/digital/websites.html", "destination": "/digital/websites", "permanent": true },
    { "source": "/express.html", "destination": "/express", "permanent": true },
    { "source": "/grow-package.html", "destination": "/grow-package", "permanent": true },
    { "source": "/mockup.html", "destination": "/mockup", "permanent": true },
    { "source": "/portfolio.html", "destination": "/portfolio", "permanent": true },
    { "source": "/services.html", "destination": "/services", "permanent": true },
    { "source": "/software/index.html", "destination": "/software/", "permanent": true },
    { "source": "/software/booking-system.html", "destination": "/software/booking-system", "permanent": true },
    { "source": "/software/fieldos.html", "destination": "/software/fieldos", "permanent": true },
    { "source": "/software/garageos.html", "destination": "/software/garageos", "permanent": true },
    { "source": "/software/pricing.html", "destination": "/software/pricing", "permanent": true },
    { "source": "/thank-you.html", "destination": "/thank-you", "permanent": true },
    { "source": "/work.html", "destination": "/work", "permanent": true },

    {
      "source": "/:path*",
      "has": [{ "type": "header", "key": "host", "value": "www.gabansolutions.ca" }],
      "destination": "https://gabansolutions.ca/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/preview/:segments*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/send-proposal", "schedule": "0 13 * * *" }
  ]
}
