{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/preview/:segments*",
      "destination": "/api/preview/:segments*"
    },
    {
      "source": "/blog",
      "destination": "/api/blog"
    },
    {
      "source": "/blog/:segments*",
      "destination": "/api/blog/:segments*"
    },
    {
      "source": "/blog-sitemap.xml",
      "destination": "/api/blog-sitemap.xml"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/bookings",
      "destination": "/admin/bookings.html"
    },
    {
      "source": "/admin/previews",
      "destination": "/admin/previews.html"
    },
    {
      "source": "/admin/blog",
      "destination": "/admin/blog.html"
    },
    {
      "source": "/admin/analytics",
      "destination": "/admin/analytics.html"
    }
  ],
  "redirects": [
    {
      "source": "/leadgen-admin.html",
      "destination": "/admin/previews",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "digital.gabansolutions.ca"
        }
      ],
      "destination": "https://gabansolutions.ca/digital/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "software.gabansolutions.ca"
        }
      ],
      "destination": "https://gabansolutions.ca/software/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/preview/:segments*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/send-proposal", "schedule": "0 13 * * *" }
  ]
}
