# Copy the values you need into Vercel's Environment Variables UI
# (Project Settings -> Environment Variables). Don't commit a real
# .env file. See leadgen/README.md for how to obtain each one.

# --- Google Places API (New) — prospect.mjs ---
# https://console.cloud.google.com/ -> enable "Places API (New)"
GOOGLE_PLACES_API_KEY=

# --- Google PageSpeed Insights — enrich.mjs (optional but recommended) ---
# Works unauthenticated at low volume; a key raises the rate limit.
GOOGLE_PAGESPEED_API_KEY=

# --- Airtable — pipeline storage, used by every leadgen script ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Prospects

# --- Resend — outbound email, send-proposal.mjs ---
RESEND_API_KEY=
LEADGEN_FROM_EMAIL="GABAN Solutions <hello@gabansolutions.ca>"

# --- Site URL used to build /api/preview and /api/unsubscribe links ---
PUBLIC_SITE_URL=https://gabansolutions.ca

# --- Secret Vercel Cron sends as `Authorization: Bearer <value>` ---
# Generate any random string, set it here and in Vercel's env vars.
CRON_SECRET=
